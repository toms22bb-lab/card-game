            // Reset post form
            function resetPostForm() {
                postContent.value = '';
                characterCount.textContent = '0/500';
                characterCount.classList.remove('warning', 'error');
                uploadedMedia = [];
                mediaPreview.innerHTML = '';
                linkData = null;
                linkInput.value = '';
                linkPreview.style.display = 'none';
                imageInput.value = '';
                videoInput.value = '';
            }
            
            // Close modal when clicking outside
            window.addEventListener('click', function(e) {
                if (e.target === postModal) {
                    postModal.style.display = 'none';
                    resetPostForm();
                }
            });

            // Add click effects to buttons
            const buttons = document.querySelectorAll('.btn');
            buttons.forEach(btn => {
                btn.addEventListener('click', function(e) {
                    // Create ripple effect
                    const ripple = document.createElement('span');
                    const rect = this.getBoundingClientRect();
                    const size = Math.max(rect.width, rect.height);
                    const x = e.clientX - rect.left - size/2;
                    const y = e.clientY - rect.top - size/2;
                    
                    ripple.style.cssText = `
                        position: absolute;
                        border-radius: 50%;
                        background: rgba(255, 255, 255, 0.6);
                        transform: scale(0);
                        animation: ripple 0.6s linear;
                        width: ${size}px;
                        height: ${size}px;
                        top: ${y}px;
                        left: ${x}px;
                    `;
                    
                    this.appendChild(ripple);
                    
                    setTimeout(() => {
                        ripple.remove();
                    }, 600);
                });
            });

            // Add to styles
            const style = document.createElement('style');
            style.textContent = `
                @keyframes ripple {
                    to {
                        transform: scale(4);
                        opacity: 0;
                    }
                }
            `;
            document.head.appendChild(style);

            // Quest completion animation
            const quests = document.querySelectorAll('.quest-card');
            quests.forEach(quest => {
                quest.addEventListener('click', function() {
                    this.style.background = 'linear-gradient(135deg, rgba(0, 255, 136, 0.2), rgba(30, 30, 42, 0.8))';
                    this.style.borderLeftColor = 'var(--accent-green)';
                    
                    const reward = this.querySelector('.quest-reward');
                    reward.innerHTML = '✅ Completed!';
                    reward.style.color = 'var(--accent-green)';
                });
            });

            // Post functionality
            const replyButtons = document.querySelectorAll('.post-action.reply-btn');
            const cancelButtons = document.querySelectorAll('.cancel-btn');
            const postReplyButtons = document.querySelectorAll('.reply-actions .reply-btn');
            const likeButtons = document.querySelectorAll('.like-btn');

            // Reply button functionality
            replyButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const replySection = this.closest('.post-card').querySelector('.reply-section');
                    replySection.style.display = 'block';
                });
            });

            // Cancel reply functionality
            cancelButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const replySection = this.closest('.reply-section');
                    replySection.style.display = 'none';
                    replySection.querySelector('.reply-input').value = '';
                });
            });

            // Post reply functionality
            postReplyButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const replySection = this.closest('.reply-section');
                    const replyInput = replySection.querySelector('.reply-input');
                    const replyText = replyInput.value.trim();
                    
                    if (replyText) {
                        const repliesContainer = replySection.previousElementSibling;
                        
                        // Create new reply
                        const newReply = document.createElement('div');
                        newReply.className = 'reply';
                        newReply.innerHTML = `
                            <div class="reply-header">
                                <div class="reply-avatar">GM</div>
                                <div class="reply-username">GameMaster</div>
                                <div class="reply-time">Just now</div>
                            </div>
                            <div class="reply-content">${replyText}</div>
                        `;
                        
                        repliesContainer.appendChild(newReply);
                        
                        // Clear input and hide reply section
                        replyInput.value = '';
                        replySection.style.display = 'none';
                        
                        // Add animation
                        newReply.style.opacity = '0';
                        newReply.style.transform = 'translateY(10px)';
                        
                        setTimeout(() => {
                            newReply.style.transition = 'all 0.3s ease';
                            newReply.style.opacity = '1';
                            newReply.style.transform = 'translateY(0)';
                        }, 10);
                    }
                });
            });

            // Like button functionality
            likeButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const likeCount = this.querySelector('.like-count');
                    let count = parseInt(likeCount.textContent);
                    
                    if (this.classList.contains('liked')) {
                        count--;
                        this.classList.remove('liked');
                    } else {
                        count++;
                        this.classList.add('liked');
                    }
                    
                    likeCount.textContent = count;
                });
            });
        });
    </script>
</body>
</html>

