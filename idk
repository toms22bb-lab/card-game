            // Handle media upload
            function handleMediaUpload(files, type) {
                for (let i = 0; i < files.length; i++) {
                    const file = files[i];
                    const reader = new FileReader();
                    
                    reader.onload = function(e) {
                        const mediaItem = {
                            type: type,
                            url: e.target.result,
                            file: file
                        };
                        
                        uploadedMedia.push(mediaItem);
                        updateMediaPreview();
                    };
                    
                    if (type === 'image') {
                        reader.readAsDataURL(file);
                    } else if (type === 'video') {
                        reader.readAsDataURL(file);
                    }
                }
            }
            
