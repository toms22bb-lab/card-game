    <script>
        // Add interactive gamification elements
        document.addEventListener('DOMContentLoaded', function() {
            // Animate XP progress bar
            const xpBar = document.querySelector('.xp-progress-fill');
            setTimeout(() => {
                xpBar.style.width = '75%';
            }, 1000);

            // Challenge Modal Functionality
            const challengeModal = document.getElementById('challengeModal');
            const createChallengeBtn = document.getElementById('createChallengeBtn');
            const closeChallengeModal = document.getElementById('closeChallengeModal');
            const cancelChallengeBtn = document.getElementById('cancelChallengeBtn');
            const challengeForm = document.getElementById('challengeForm');
            const challengeDescription = document.getElementById('challengeDescription');
            const challengeCharCount = document.getElementById('challengeCharCount');
            const challengeIdDisplay = document.getElementById('challengeIdDisplay');
            const copyIdBtn = document.getElementById('copyIdBtn');
            const createChallengeSubmitBtn = document.getElementById('createChallengeSubmitBtn');
            const challengeType = document.getElementById('challengeType');
            const prizeInputs = document.getElementById('prizeInputs');
            const entryFeeInput = document.getElementById('entryFee');
            const maxParticipantsInput = document.getElementById('maxParticipants');

            // Generate random challenge ID
            function generateChallengeId() {
                const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
                let result = 'CH-';
                for (let i = 0; i < 8; i++) {
                    result += chars.charAt(Math.floor(Math.random() * chars.length));
                }
                return result;
            }

            // Challenge type change handler
            challengeType.addEventListener('change', function() {
                if (this.value === 'tournament') {
                    // Show prize inputs for tournaments
                    prizeInputs.classList.add('show');
                    
                    // Set default max participants for tournaments
                    maxParticipantsInput.value = 8;
                    maxParticipantsInput.min = 4;
                    
                    // Update entry fee placeholder
                    entryFeeInput.placeholder = "Entry fee per participant (€)";
                } else {
                    // Hide prize inputs for other challenge types
                    prizeInputs.classList.remove('show');
                    
                    // Reset max participants
                    maxParticipantsInput.min = 2;
                    if (this.value === '1v1') {
                        maxParticipantsInput.value = 2;
                    }
                    
                    // Reset entry fee placeholder
                    entryFeeInput.placeholder = "Enter entry fee amount";
                }
            });

            // Open challenge modal
            createChallengeBtn.addEventListener('click', function() {
                // Generate new challenge ID
                const challengeId = generateChallengeId();
                challengeIdDisplay.textContent = challengeId;
                
                // Reset form
                challengeForm.reset();
                challengeCharCount.textContent = '0/500';
                challengeCharCount.classList.remove('warning', 'error');
                prizeInputs.classList.remove('show');
                
                // Show modal
                challengeModal.style.display = 'flex';
            });

            // Close challenge modal
            closeChallengeModal.addEventListener('click', function() {
                challengeModal.style.display = 'none';
            });

            cancelChallengeBtn.addEventListener('click', function() {
                challengeModal.style.display = 'none';
            });

            // Character count for challenge description
            challengeDescription.addEventListener('input', function() {
                const count = this.value.length;
                challengeCharCount.textContent = `${count}/500`;
                
                if (count > 450) {
                    challengeCharCount.classList.add('warning');
                    challengeCharCount.classList.remove('error');
                } else if (count > 490) {
                    challengeCharCount.classList.remove('warning');
                    challengeCharCount.classList.add('error');
                } else {
                    challengeCharCount.classList.remove('warning', 'error');
                }
            });

            // Copy challenge ID
            copyIdBtn.addEventListener('click', function() {
                const challengeId = challengeIdDisplay.textContent;
                navigator.clipboard.writeText(challengeId).then(function() {
                    // Show copied feedback
                    const originalText = copyIdBtn.textContent;
                    copyIdBtn.textContent = 'Copied!';
                    copyIdBtn.style.background = 'var(--accent-green)';
                    
                    setTimeout(() => {
                        copyIdBtn.textContent = originalText;
                        copyIdBtn.style.background = 'var(--accent-blue)';
                    }, 2000);
                }).catch(function(err) {
                    console.error('Could not copy text: ', err);
                    alert('Failed to copy challenge ID');
                });
            });

            // Form submission
            challengeForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                // Get form values
                const entryFee = document.getElementById('entryFee').value;
                const game = document.getElementById('challengeGame').value;
                const description = document.getElementById('challengeDescription').value;
                const challengeType = document.getElementById('challengeType').value;
                const maxParticipants = document.getElementById('maxParticipants').value;
                const challengeId = challengeIdDisplay.textContent;
                
                // Get prize values if tournament
                let prizes = null;
                if (challengeType === 'tournament') {
                    prizes = {
                        first: document.getElementById('firstPrize').value || 0,
                        second: document.getElementById('secondPrize').value || 0,
                        third: document.getElementById('thirdPrize').value || 0
                    };
                }
                
                // Validate form
                if (!entryFee || !game || !description) {
                    alert('Please fill in all required fields');
                    return;
                }
                
                if (entryFee < 1 || entryFee > 1000) {
                    alert('Entry fee must be between €1 and €1000');
                    return;
                }
                
                // Create challenge object
                const challengeData = {
                    id: challengeId,
                    entryFee: parseFloat(entryFee),
                    game: game,
                    description: description,
                    type: challengeType,
                    maxParticipants: parseInt(maxParticipants),
                    creator: 'GameMaster',
                    timestamp: new Date().toISOString(),
                    status: 'open'
                };
                
                // Add prizes if tournament
                if (challengeType === 'tournament' && prizes) {
                    challengeData.prizes = prizes;
                    challengeData.totalPrizePool = calculatePrizePool(entryFee, maxParticipants, prizes);
                }
                
                // In a real app, you would send this data to your backend
                console.log('Challenge created:', challengeData);
                
                // Add the new challenge to the community grid
                addNewChallenge(challengeData);
                
                // Close modal
                challengeModal.style.display = 'none';
                
                // Show success message
                showChallengeSuccess(challengeData);
            });

            // Helper function to calculate total prize pool
            function calculatePrizePool(entryFee, maxParticipants, prizes) {
                const totalFees = entryFee * maxParticipants;
                const prizeSum = parseFloat(prizes.first || 0) + parseFloat(prizes.second || 0) + parseFloat(prizes.third || 0);
                
                // Return the larger of total fees or specified prizes
                return Math.max(totalFees, prizeSum);
            }

            // Add new challenge to the community grid
            function addNewChallenge(challengeData) {
                const communityGrid = document.querySelector('.community-grid');
                
                // Format game name for display
                const gameNames = {
                    'valorant': 'Valorant',
                    'cs2': 'CS2',
                    'fortnite': 'Fortnite',
                    'lol': 'League of Legends',
                    'dota2': 'Dota 2',
                    'overwatch': 'Overwatch 2',
                    'rainbow6': 'Rainbow Six Siege',
                    'cod': 'Call of Duty'
                };
                
                // Format challenge type for badge
                const typeBadges = {
                    '1v1': '1V1 DUEL',
                    'team': 'TEAM MATCH',
                    'tournament': 'TOURNAMENT',
                    'custom': 'CUSTOM'
                };
                
                // Create new challenge element
                const challengeElement = document.createElement('div');
                challengeElement.className = 'challenge-card';
                if (challengeData.type === 'tournament') {
                    challengeElement.classList.add('featured');
                }
                challengeElement.setAttribute('data-type', 'challenge');
                
                // Build prize HTML if tournament
                let prizeHTML = '';
                if (challengeData.type === 'tournament' && challengeData.prizes) {
                    prizeHTML = `
                        <div style="margin: 10px 0; padding: 10px; background: rgba(255,215,0,0.1); border-radius: 8px; border-left: 3px solid var(--accent-gold);">
                            <div style="font-size: 12px; color: var(--accent-gold); margin-bottom: 5px;">🏆 Prize Pool: €${challengeData.totalPrizePool}</div>
                            <div style="font-size: 11px; color: var(--text-secondary);">
                                ${challengeData.prizes.first ? `🥇 €${challengeData.prizes.first}` : ''}
                                ${challengeData.prizes.second ? ` 🥈 €${challengeData.prizes.second}` : ''}
                                ${challengeData.prizes.third ? ` 🥉 €${challengeData.prizes.third}` : ''}
                            </div>
                        </div>
                    `;
                }
                
                challengeElement.innerHTML = `
                    <div class="challenge-header">
                        <div class="challenge-badge">${typeBadges[challengeData.type] || 'CHALLENGE'}</div>
                        <div class="xp-reward">
                            <span>⭐</span> ${challengeData.type === 'tournament' ? '100' : '25'} XP
                        </div>
                    </div>
                    <div class="player-info">
                        <div class="player-avatar">
                            GM
                            <div class="player-level">42</div>
                        </div>
                        <div class="player-details">
                            <div class="player-name">${challengeData.creator}</div>
                            <div class="player-game">${gameNames[challengeData.game]} • ${challengeData.type === '1v1' ? '1v1 Duel' : challengeData.type}</div>
                            ${challengeData.type === 'tournament' ? '<div class="stream-indicator"><span>🔴</span> Tournament</div>' : ''}
                        </div>
                    </div>
                    <div class="challenge-title">${challengeData.description.substring(0, 60)}${challengeData.description.length > 60 ? '...' : ''}</div>
                    ${prizeHTML}
                    <div class="challenge-stake">
                        <span class="stake-label">${challengeData.type === 'tournament' ? 'Entry Fee:' : 'Stake:'}</span>
                        <span class="stake-amount">€${challengeData.entryFee}</span>
                    </div>
                    <div class="participants">
                        <div class="participant-avatars">
                            <div class="avatar online">GM</div>
                            <div class="avatar">?</div>
                            ${challengeData.type === 'tournament' ? '<div class="avatar">+</div>' : ''}
                        </div>
                        <div class="participant-count">1/${challengeData.maxParticipants} ${challengeData.type === 'tournament' ? 'teams' : 'participants'}</div>
                    </div>
                    <div class="challenge-actions">
                        <button class="btn ${challengeData.type === 'tournament' ? 'btn-warning' : 'btn-primary'} btn-small join-challenge-btn">${challengeData.type === 'tournament' ? 'Join Tournament' : 'Join Challenge'}</button>
                        <button class="btn btn-secondary btn-small">Watch</button>
                    </div>
                `;
                
                // Add the new challenge at the beginning of the community grid
                communityGrid.insertBefore(challengeElement, communityGrid.firstChild);
                
                // Add event listener to join button
                const joinBtn = challengeElement.querySelector('.join-challenge-btn');
                joinBtn.addEventListener('click', function() {
                    if (challengeData.type === 'tournament') {
                        alert(`Joining tournament: ${challengeData.id}\nEntry Fee: €${challengeData.entryFee}\nPrize Pool: €${challengeData.totalPrizePool}`);
                    } else {
                        alert(`Joining challenge: ${challengeData.id}\nEntry Fee: €${challengeData.entryFee}`);
                    }
                    // In a real app, this would open a payment/confirmation modal
                });
            }

            // Show success message
            function showChallengeSuccess(challengeData) {
                // Create success notification
                const successNotification = document.createElement('div');
                successNotification.style.cssText = `
                    position: fixed;
                    top: 100px;
                    right: 20px;
                    background: linear-gradient(135deg, var(--accent-green), #00cc77);
                    color: white;
                    padding: 15px 20px;
                    border-radius: 12px;
                    box-shadow: 0 8px 25px rgba(0, 255, 136, 0.4);
                    z-index: 1009;
                    max-width: 300px;
                    animation: slideInRight 0.3s ease;
                `;
                
                successNotification.innerHTML = `
                    <div style="font-weight: 600; margin-bottom: 5px;">✅ Challenge Created!</div>
                    <div style="font-size: 14px; opacity: 0.9;">Your challenge is now live. ID: ${challengeData.id}</div>
                `;
                
                document.body.appendChild(successNotification);
                
                // Remove after 5 seconds
                setTimeout(() => {
                    successNotification.style.animation = 'slideOutRight 0.3s ease';
                    setTimeout(() => {
                        if (successNotification.parentNode) {
                            successNotification.parentNode.removeChild(successNotification);
                        }
                    }, 300);
                }, 5000);
                
                // Add animation styles if not already present
                if (!document.getElementById('challengeAnimations')) {
                    const style = document.createElement('style');
                    style.id = 'challengeAnimations';
                    style.textContent = `
                        @keyframes slideInRight {
                            from {
                                transform: translateX(100%);
                                opacity: 0;
                            }
                            to {
                                transform: translateX(0);
                                opacity: 1;
                            }
                        }
                        @keyframes slideOutRight {
                            from {
                                transform: translateX(0);
                                opacity: 1;
                            }
                            to {
                                transform: translateX(100%);
                                opacity: 0;
                            }
                        }
                    `;
                    document.head.appendChild(style);
                }
            }

            // Close modal when clicking outside
            window.addEventListener('click', function(e) {
                if (e.target === challengeModal) {
                    challengeModal.style.display = 'none';
                }
            });

            // ... (visa kita JavaScript logika išlaikoma) ...

            // Auth Modal Functionality
            const authModal = document.getElementById('authModal');
            const authBtn = document.getElementById('authBtn');
            const loginTab = document.getElementById('loginTab');
            const registerTab = document.getElementById('registerTab');
            const loginForm = document.getElementById('loginForm');
            const registerForm = document.getElementById('registerForm');
            const forgotPasswordForm = document.getElementById('forgotPasswordForm');
            const switchToLogin = document.getElementById('switchToLogin');
            const forgotPassword = document.getElementById('forgotPassword');
            const backToLogin = document.getElementById('backToLogin');
            
            // Open auth modal
            authBtn.addEventListener('click', function() {
                authModal.style.display = 'flex';
                showForm('login');
            });
            
            // Tab switching
            loginTab.addEventListener('click', function() {
                showForm('login');
                loginTab.classList.add('active');
                registerTab.classList.remove('active');
            });
            
            registerTab.addEventListener('click', function() {
                showForm('register');
                registerTab.classList.add('active');
                loginTab.classList.remove('active');
            });
            
            // Form switching
            switchToLogin.addEventListener('click', function(e) {
                e.preventDefault();
                showForm('login');
                loginTab.classList.add('active');
                registerTab.classList.remove('active');
            });
            
            forgotPassword.addEventListener('click', function(e) {
                e.preventDefault();
                showForm('forgot');
            });
            
            backToLogin.addEventListener('click', function(e) {
                e.preventDefault();
                showForm('login');
            });
            
            function showForm(formType) {
                // Hide all forms
                loginForm.classList.remove('active');
                registerForm.classList.remove('active');
                forgotPasswordForm.classList.remove('active');
                
                // Clear error/success messages
                clearMessages();
                
                // Show selected form
                if (formType === 'login') {
                    loginForm.classList.add('active');
                } else if (formType === 'register') {
                    registerForm.classList.add('active');
                } else if (formType === 'forgot') {
                    forgotPasswordForm.classList.add('active');
                }
            }
            
            function clearMessages() {
                document.querySelectorAll('.error-message, .success-message').forEach(msg => {
                    msg.style.display = 'none';
                    msg.textContent = '';
                });
            }
            
            function showMessage(elementId, message, isError = true) {
                clearMessages();
                const element = document.getElementById(elementId);
                element.textContent = message;
                element.style.display = 'block';
                element.style.color = isError ? '#ff4444' : 'var(--accent-green)';
            }
            
            // Login form submission
            loginForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                const username = document.getElementById('loginUsername').value;
                const password = document.getElementById('loginPassword').value;
                const rememberMe = document.getElementById('rememberMe').checked;
                
                // Simple validation
                if (!username || !password) {
                    showMessage('loginError', 'Please fill in all fields');
                    return;
                }
                
                // Simulate login process
                // In a real app, you would send this to your backend
                console.log('Login attempt:', { username, password, rememberMe });
                
                // Simulate successful login
                setTimeout(() => {
                    // For demo purposes, we'll assume login is successful
                    showMessage('loginSuccess', 'Login successful! Redirecting...', false);
                    
                    // Update UI to show user is logged in
                    updateUIAfterLogin(username);
                    
                    // Close modal after delay
                    setTimeout(() => {
                        authModal.style.display = 'none';
                        clearMessages();
                        loginForm.reset();
                    }, 1500);
                }, 1000);
            });
            
            // Register form submission
            registerForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                const username = document.getElementById('registerUsername').value;
                const email = document.getElementById('registerEmail').value;
                const password = document.getElementById('registerPassword').value;
                const confirmPassword = document.getElementById('registerConfirmPassword').value;
                const acceptTerms = document.getElementById('acceptTerms').checked;
                
                // Validation
                if (!username || !email || !password || !confirmPassword) {
                    showMessage('registerError', 'Please fill in all fields');
