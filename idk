
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MachUp - High Stakes Gaming</title>
    <style>
        :root {
            --bg-dark: #0F0F0F;
            --bg-card: rgba(30, 30, 42, 0.7);
            --bg-secondary: rgba(44, 44, 58, 0.5);
            --accent-blue: #007BFF;
            --accent-green: #00FF88;
            --accent-orange: #FF4500;
            --accent-purple: #8A2BE2;
            --accent-gold: #FFD700;
            --text-primary: #FFFFFF;
            --text-secondary: #B0B0C0;
            --glass-blur: 12px;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background: linear-gradient(135deg, #0F0F0F 0%, #1a1a2e 50%, #16213e 100%);
            color: var(--text-primary);
            min-height: 100vh;
            padding: 20px;
            position: relative;
        }
        
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                radial-gradient(circle at 20% 80%, rgba(0, 123, 255, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(0, 255, 136, 0.12) 0%, transparent 50%),
                radial-gradient(circle at 40% 40%, rgba(255, 69, 0, 0.1) 0%, transparent 50%);
            z-index: -1;
        }

        /* XP Progress Bar */
        .xp-progress {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: rgba(255, 255, 255, 0.1);
            z-index: 1001;
        }

        .xp-progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--accent-blue), var(--accent-green), var(--accent-gold));
            width: 65%;
            transition: width 0.5s ease;
            position: relative;
            overflow: hidden;
        }

        .xp-progress-fill::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
            animation: shimmer 2s infinite;
        }

        @keyframes shimmer {
            0% { left: -100%; }
            100% { left: 100%; }
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        
        /* Updated Search Bar */
        .search-container {
            position: fixed;
            top: 90px;
            right: 20px;
            z-index: 1002;
            display: flex;
            gap: 10px;
        }

        .search-bar {
            display: flex;
            background: rgba(30, 30, 42, 0.8);
            backdrop-filter: blur(var(--glass-blur));
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            overflow: hidden;
            transition: all 0.3s ease;
            width: 50px; /* Start with just the button width */
        }

        .search-bar:hover {
            width: 300px; /* Expand on hover */
            box-shadow: 0 0 0 2px var(--accent-blue);
        }

        .search-input {
            background: transparent;
            border: none;
            padding: 12px 15px;
            color: var(--text-primary);
            width: 250px;
            font-size: 14px;
            outline: none;
            opacity: 0; /* Initially hidden */
            transition: opacity 0.3s ease;
        }

        .search-bar:hover .search-input {
            opacity: 1; /* Show on hover */
        }

        .search-input::placeholder {
            color: var(--text-secondary);
        }

        .search-btn {
            background: var(--accent-blue);
            border: none;
            padding: 0 15px;
            color: white;
            cursor: pointer;
            transition: all 0.3s ease;
            width: 50px; /* Fixed width for the button */
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px; /* Larger emoji */
        }

        .search-btn:hover {
            background: #0056b3;
        }

        /* Magnifying Glass Emoji that's always visible */
        .magnifying-glass {
            position: fixed;
            top: 90px;
            right: 20px;
            width: 50px;
            height: 50px;
            background: rgba(30, 30, 42, 0.8);
            backdrop-filter: blur(var(--glass-blur));
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            z-index: 1001;
            transition: all 0.3s ease;
            pointer-events: none; /* Allow clicks to pass through to search bar */
        }

        .search-bar:hover + .magnifying-glass {
            opacity: 0; /* Hide when search bar is expanded */
        }

        /* Account Modal Styles */
        .account-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(5px);
            z-index: 1004;
            justify-content: center;
            align-items: center;
        }
        
        .account-modal-content {
            background: rgba(30, 30, 42, 0.95);
            backdrop-filter: blur(var(--glass-blur));
            width: 90%;
            max-width: 600px;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.1);
            animation: modalAppear 0.3s ease-out;
            max-height: 90vh;
            overflow-y: auto;
        }
        
        .account-header {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 25px;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .account-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent-blue), var(--accent-green));
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 24px;
            box-shadow: 0 8px 25px rgba(0, 123, 255, 0.4);
            position: relative;
        }
        
        .account-level {
            position: absolute;
            bottom: -5px;
            right: -5px;
            background: var(--accent-gold);
            color: var(--bg-dark);
            font-size: 14px;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            border: 3px solid var(--bg-dark);
        }
        
        .account-info {
            flex: 1;
        }
        
        .account-username {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 5px;
        }
        
        .account-xp {
            font-size: 14px;
            color: var(--text-secondary);
        }
        
        .account-section {
            margin-bottom: 25px;
        }
        
        .account-section-title {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .account-section-title::before {
            font-size: 16px;
        }
        
        .bio-section .account-section-title::before {
            content: '📝';
        }
        
        .region-section .account-section-title::before {
            content: '🌍';
        }
        
        .posts-section .account-section-title::before {
            content: '📋';
        }
        
        .account-bio {
            background: rgba(15, 15, 15, 0.6);
            padding: 15px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 15px;
            line-height: 1.5;
        }
        
        .account-settings {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        
        .setting-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 15px;
            background: rgba(15, 15, 15, 0.6);
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .setting-label {
            font-weight: 500;
        }
        
        .setting-control {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .visibility-select {
            background: rgba(30, 30, 42, 0.8);
            color: var(--text-primary);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 14px;
            outline: none;
        }
        
        .region-select {
            background: rgba(30, 30, 42, 0.8);
            color: var(--text-primary);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 14px;
            outline: none;
            min-width: 150px;
        }
        
        .account-posts {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        
        .account-post {
            background: rgba(15, 15, 15, 0.6);
            padding: 15px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            position: relative;
        }
        
        .account-post-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            font-size: 14px;
            color: var(--text-secondary);
        }
        
        .account-post-content {
            line-height: 1.5;
            margin-bottom: 10px;
        }
        
        .account-post-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .account-post-likes {
            display: flex;
            align-items: center;
            gap: 5px;
            color: var(--text-secondary);
            font-size: 14px;
        }
        
        .delete-post-btn {
            background: rgba(255, 69, 0, 0.2);
            border: 1px solid rgba(255, 69, 0, 0.5);
            color: var(--accent-orange);
            border-radius: 6px;
            padding: 6px 12px;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .delete-post-btn:hover {
            background: rgba(255, 69, 0, 0.4);
        }
        
        .no-posts {
            text-align: center;
            padding: 30px;
            color: var(--text-secondary);
            font-style: italic;
        }

        /* Profile Dropdown */
        .profile-dropdown {
            position: fixed;
            background: rgba(30, 30, 42, 0.95);
            backdrop-filter: blur(var(--glass-blur));
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
            z-index: 1003;
            min-width: 180px;
            overflow: hidden;
            display: none;
        }

        .profile-dropdown.show {
            display: block;
            animation: dropdownAppear 0.3s ease;
        }

        @keyframes dropdownAppear {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .dropdown-item {
            padding: 12px 20px;
            background: none;
            border: none;
            color: var(--text-primary);
            width: 100%;
            text-align: left;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .dropdown-item:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        .dropdown-item:not(:last-child) {
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .dropdown-icon {
            font-size: 16px;
            width: 20px;
            text-align: center;
        }

        /* Back to Top Button */
        .back-to-top {
            position: fixed;
            bottom: 100px;
            right: 30px;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent-purple), #6A0DAD);
            color: white;
            border: none;
            cursor: pointer;
            box-shadow: 0 8px 25px rgba(138, 43, 226, 0.4);
            z-index: 1000;
            display: none;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            transition: all 0.3s ease;
        }

        .back-to-top:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(138, 43, 226, 0.6);
        }

        /* Post Button */
        .post-btn {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent-blue), var(--accent-green));
            color: white;
            border: none;
            font-size: 20px;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 8px 25px rgba(0, 123, 255, 0.4);
            z-index: 1000;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .post-btn::before {
            content: 'P';
            transition: all 0.3s ease;
        }

        .post-btn::after {
            content: 'Post';
            position: absolute;
            opacity: 0;
            transform: translateY(10px);
            transition: all 0.3s ease;
        }

        .post-btn:hover {
            width: 120px;
            border-radius: 30px;
        }

        .post-btn:hover::before {
            opacity: 0;
            transform: translateY(-10px);
        }

        .post-btn:hover::after {
            opacity: 1;
            transform: translateY(0);
        }

        .post-btn:hover {
            transform: scale(1.1);
            box-shadow: 0 12px 30px rgba(0, 123, 255, 0.6);
        }

        /* Enhanced Header with User Stats */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 30px;
            margin-bottom: 20px;
            background: rgba(30, 30, 42, 0.4);
            backdrop-filter: blur(var(--glass-blur));
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            position: relative;
        }

        .user-stats {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .level-badge {
            background: linear-gradient(135deg, var(--accent-gold), #FFA500);
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 18px;
            box-shadow: 0 4px 20px rgba(255, 215, 0, 0.4);
            border: 2px solid rgba(255, 255, 255, 0.3);
        }

        .user-info {
            display: flex;
            flex-direction: column;
            gap: 5px;
            position: relative;
        }

        .username {
            font-weight: 700;
            font-size: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            position: relative;
        }

        .user-xp {
            font-size: 12px;
            color: var(--text-secondary);
        }

        .logo {
            font-size: 28px;
            font-weight: 700;
            color: var(--accent-blue);
            display: flex;
            align-items: center;
            gap: 10px;
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
        }
        
        .logo-icon {
            color: var(--accent-green);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }
        
        .header-actions {
            display: flex;
            gap: 15px;
            align-items: center;
        }
        
        .btn {
            padding: 10px 20px;
            border-radius: 12px;
            border: none;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s;
        }

        .btn:hover::before {
            left: 100%;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, var(--accent-blue), #0056b3);
            color: white;
            box-shadow: 0 4px 15px rgba(0, 123, 255, 0.3);
        }
        
        .btn-secondary {
            background: rgba(255, 255, 255, 0.1);
            color: var(--accent-blue);
            border: 1px solid var(--accent-blue);
        }
        
        .btn-accent {
            background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-green) 100%);
            color: var(--bg-dark);
            font-weight: 700;
            box-shadow: 0 4px 20px rgba(0, 123, 255, 0.4);
        }
        
        .btn-warning {
            background: linear-gradient(135deg, var(--accent-orange), #ff6b35);
            color: white;
            box-shadow: 0 4px 15px rgba(255, 69, 0, 0.3);
        }

        /* Login/Register button with dropdown effect */
        .btn-auth {
            background: linear-gradient(135deg, var(--accent-purple), #6A0DAD);
            color: white;
            box-shadow: 0 4px 15px rgba(138, 43, 226, 0.3);
            position: relative;
        }

        .auth-dropdown {
            position: fixed;
            background: rgba(30, 30, 42, 0.95);
            backdrop-filter: blur(var(--glass-blur));
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
            z-index: 1003;
            min-width: 150px;
            overflow: hidden;
            display: none;
        }

        .auth-dropdown.show {
            display: block;
            animation: dropdownAppear 0.3s ease;
        }

        @keyframes dropdownAppear {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .auth-option {
            padding: 12px 20px;
            background: none;
            border: none;
            color: var(--text-primary);
            width: 100%;
            text-align: left;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 14px;
        }

        .auth-option:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        .auth-option:first-child {
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .auth-container {
            position: relative;
        }
        
        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0, 123, 255, 0.4);
        }

        /* Quest Section */
        .quests-section {
            margin: 20px 0;
            padding: 20px;
            background: rgba(30, 30, 42, 0.4);
            backdrop-filter: blur(var(--glass-blur));
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .section-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .section-title::before {
            content: '🎯';
            font-size: 18px;
        }

        .quests-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
        }

        .quest-card {
            background: rgba(255, 255, 255, 0.05);
            padding: 15px;
            border-radius: 12px;
            border-left: 4px solid var(--accent-green);
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s ease;
        }

        .quest-card:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateX(5px);
        }

        .quest-info h4 {
            font-size: 14px;
            margin-bottom: 5px;
        }

        .quest-reward {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 12px;
            color: var(--accent-gold);
        }

        /* Enhanced Stats with Icons */
        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin: 20px 0;
        }
        
        .stat-item {
            background: rgba(30, 30, 42, 0.4);
            backdrop-filter: blur(var(--glass-blur));
            padding: 20px;
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            text-align: center;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            cursor: pointer;
        }

        .stat-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, var(--accent-blue), var(--accent-green));
        }

        .stat-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 123, 255, 0.2);
        }

        .stat-item.active {
            background: rgba(0, 123, 255, 0.2);
            border: 1px solid var(--accent-blue);
        }

        .stat-icon {
            font-size: 24px;
            margin-bottom: 10px;
        }
        
        .stat-value {
            font-size: 28px;
            font-weight: 700;
            color: var(--accent-green);
            margin-bottom: 5px;
        }
        
        .stat-label {
            font-size: 14px;
            color: var(--text-secondary);
        }

        /* Games Navigation with Achievement Badges */
        .games-nav {
            display: flex;
            gap: 10px;
            margin: 20px 0;
            padding: 15px 20px;
            background: rgba(30, 30, 42, 0.4);
            backdrop-filter: blur(var(--glass-blur));
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            overflow-x: auto;
        }
        
        .game-tab {
            padding: 12px 20px;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 600;
            white-space: nowrap;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            position: relative;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .achievement-badge {
            background: var(--accent-gold);
            color: var(--bg-dark);
            font-size: 10px;
            padding: 2px 6px;
            border-radius: 10px;
            font-weight: bold;
        }
        
        .game-tab.active {
            background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-green) 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(0, 123, 255, 0.3);
        }
        
        .game-tab:not(.active):hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateY(-2px);
        }

        /* Community Posts Section */
        .community-posts-section {
            margin-top: 40px;
        }

        .community-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
